// Dear-Ded 自有层（最高优先级）
// apps: 自有/覆写规则。同 app 同名 group 整体替换上游；新 group 追加；新 app 直接加入。
// disable: 点名禁用上游规则组，条目 {appId, groupName}，合并时置 enable:false。
// globalGroups: 自有全局规则。同名替换上游；新名追加。只放收紧过的补充。
// 规则依据快照编写（snapshotUrls），来源标注在 desc 中。
// 开屏组名会触发全局规则 disableIfAppGroupMatch。覆写时若仍要保留全局开屏，必须带 ignoreGlobalGroupMatch:true。
{
  apps: [
    {
      id: 'com.ximalaya.ting.android',
      name: '喜马拉雅',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          desc: '自有覆写。上游这条「开屏广告」只点 text*=跳过，实际点到不可点击的倒计时文案（vid=xm_ad_host_count_down_text，「跳过广告」），真正热区是旁边的 vid=xm_ad_host_count_down_click_lay；同名组还会让三条全局开屏因 disableIfAppGroupMatch 全部停用。本层改为点可点击热区，不点摇一摇，并 ignoreGlobalGroupMatch 让全局开屏继续处理第三方 SDK。依据 AIsouler/GKD_subscription#1252 的 MainActivity 快照（9.4.7.3）。',
          enable: true,
          ignoreGlobalGroupMatch: true,
          matchTime: 10000,
          actionMaximum: 2,
          resetMatch: 'app',
          priorityTime: 10000,
          forcedTime: 10000,
          actionCd: 800,
          actionCdKey: 0,
          order: -10,
          rules: [
            {
              key: 0,
              name: '自定义跳过热区',
              fastQuery: true,
              activityIds: [
                '.host.activity.MainActivity',
                '.host.activity.WelComeActivity',
              ],
              matches:
                '[vid="xm_ad_host_count_down_click_lay"][clickable=true][visibleToUser=true]',
            },
            {
              key: 1,
              name: '开屏容器内可点的跳过',
              desc: '热区改名时的兜底。排除名为 no_click 的重叠层和摇一摇热区，避免点开广告。',
              fastQuery: false,
              activityIds: [
                '.host.activity.MainActivity',
                '.host.activity.WelComeActivity',
              ],
              matches:
                '[vid="host_splash_skip_layout"] > [clickable=true][visibleToUser=true][width<500&&height<300][(text^="跳过"||desc^="跳过"||text*="跳 过")][vid!="xm_ad_host_count_down_click_lay_no_click_view"][vid!="xm_ad_host_shake_click_view"]',
            },
            {
              key: 2,
              name: '穿山甲开屏跳过',
              desc: '全屏视频或 SDK 开屏上的 tt_splash_skip_btn。不限定 Activity，该 id 只出现在开屏。',
              fastQuery: true,
              matches: '[vid="tt_splash_skip_btn"][visibleToUser=true]',
            },
          ],
        },
      ],
    },
    {
      id: 'com.ximalaya.ting.lite',
      name: '喜马拉雅极速版',
      groups: [
        {
          key: 0,
          name: '开屏广告',
          desc: '自有补充。极速版原先没有应用内开屏组，全局开屏仍生效（ignoreGlobalGroupMatch）。补上与主版相同的自定义跳过热区，资源名一致时即可跳过；摇一摇热区不点。',
          enable: true,
          ignoreGlobalGroupMatch: true,
          matchTime: 10000,
          actionMaximum: 2,
          resetMatch: 'app',
          priorityTime: 10000,
          forcedTime: 10000,
          actionCd: 800,
          actionCdKey: 0,
          order: -10,
          rules: [
            {
              key: 0,
              name: '自定义跳过热区',
              fastQuery: true,
              activityIds: [
                '.host.activity.MainActivity',
                '.host.activity.WelComeActivity',
              ],
              matches:
                '[vid="xm_ad_host_count_down_click_lay"][clickable=true][visibleToUser=true]',
            },
            {
              key: 1,
              name: '开屏容器内可点的跳过',
              desc: '热区改名时的兜底。排除名为 no_click 的重叠层和摇一摇热区，避免点开广告。',
              fastQuery: false,
              activityIds: [
                '.host.activity.MainActivity',
                '.host.activity.WelComeActivity',
              ],
              matches:
                '[vid="host_splash_skip_layout"] > [clickable=true][visibleToUser=true][width<500&&height<300][(text^="跳过"||desc^="跳过"||text*="跳 过")][vid!="xm_ad_host_count_down_click_lay_no_click_view"][vid!="xm_ad_host_shake_click_view"]',
            },
            {
              key: 2,
              name: '穿山甲开屏跳过',
              desc: '全屏视频或 SDK 开屏上的 tt_splash_skip_btn。不限定 Activity，该 id 只出现在开屏。',
              fastQuery: true,
              matches: '[vid="tt_splash_skip_btn"][visibleToUser=true]',
            },
          ],
        },
      ],
    },
    {
      id: 'com.github.android',
      name: 'GitHub',
      groups: [
        {
          key: 1,
          name: '功能类-自动批准授权验证',
          desc: '自有覆写。Lin-arm v647 的 perf 改写去掉了 matchRoot；2FA 输码时事件节点是 EditText，默认匹配从事件节点向下找子孙，到不了根部的 android:id/content，批准按钮会 miss（Codex 在 PR #30 的审阅意见）。本层只补回 matchRoot:true，其余与上游 v647 一致。原说明：输入2位数字后-> 批准-> 关闭。',
          activityIds: '.twofactor.TwoFactorActivity',
          fastQuery: true,
          rules: [
            {
              key: 0,
              name: '①点击[批准]',
              matchRoot: true,
              matches:
                '@View[clickable=true][getChild(0).text="批准"] -2 EditText[text.length>=2] -2 [text="身份验证请求"] < View <<5 [id="android:id/content"]',
              snapshotUrls: 'https://i.gkd.li/i/28906388',
              exampleUrls:
                'https://e.gkd.li/86a9d677-6f59-4a3a-81d0-8bb0d6847ca9',
            },
            {
              preKeys: [0],
              name: '②点击[关闭]',
              matches:
                '@View[clickable=true][getChild(0).text="关闭" && visibleToUser=true] -(1,2) [text="登录已批准" || text="无法批准" || text="未找到登录请求"] < * <<5 [id="android:id/content"]',
              snapshotUrls: [
                'https://i.gkd.li/i/25366553',
                'https://i.gkd.li/i/25366549',
                'https://i.gkd.li/i/32758660',
              ],
              exampleUrls: [
                'https://e.gkd.li/e18eed95-993a-4148-b486-27e64e709188',
                'https://e.gkd.li/c165be1d-f0d4-47d0-8a39-3aac562885b1',
                'https://e.gkd.li/4bb620ca-a35a-40c1-ad80-8c777bf86d02',
              ],
            },
          ],
        },
      ],
    },
    {
      id: 'com.dragon.read',
      name: '番茄免费小说',
      groups: [
        {
          key: 23,
          name: '功能类-自动[展开更多]评论',
          desc: '自有覆写。去掉上游新增的通用 [text="展开"] 匹配——它不限定评论区，在小说阅读页与短剧页会把简介的「展开」也点开，与同批新增的「功能类-自动[展开]简介」冲突（Codex 在 PR #30 的审阅意见）；其余与上游 Lin-arm v647 一致，待上游给出带评论区限定的选择器后再跟进。原说明：小说段评区/评分区；短剧评论区/剧评区，点击[展开更多/展开n条回复]。',
          fastQuery: true,
          actionCd: 500,
          rules: [
            {
              key: 1,
              name: '①[展开]点评',
              activityIds: [
                'com.dragon.community.impl.comment.playlet.list.page.CSSPlayletCommentListActivity',
                'com.dragon.community.impl.list.page.CSSBookCommentListActivity',
              ],
              matches:
                '[text$="后点评"] < LinearLayout -2 ViewGroup > [text="展开"][clickable=true]',
              snapshotUrls: [
                'https://i.gkd.li/i/35494357',
                'https://i.gkd.li/i/35494382',
              ],
              exampleUrls: [
                'https://e.gkd.li/5ffee787-dca6-4e91-b908-96bf8f896e47',
                'https://e.gkd.li/f81b3c2e-5b56-4dab-8eac-ba38396ab972',
              ],
            },
            {
              key: 2,
              name: '②[展开]评论/回复',
              activityIds: [
                '.reader.ui.ReaderActivity',
                '.pages.main.MainFragmentActivity',
                '.ad.openingscreenad.OpeningScreenADActivity',
                '.component.shortvideo.impl.ShortSeriesActivity',
              ],
              matches: [
                '[id="android:id/content"][height>prev.height.plus(100)] >n [id="android:id/content"][height>500]',
                '@[clickable=true] > [visibleToUser=true][text^="展开"][text$="回复" || text$="更多"]',
              ],
              snapshotUrls: [
                'https://i.gkd.li/i/35147917',
                'https://i.gkd.li/i/35147919',
                'https://i.gkd.li/i/35173217',
                'https://i.gkd.li/i/35494237',
                'https://i.gkd.li/i/35203330',
                'https://i.gkd.li/i/35203316',
              ],
              excludeSnapshotUrls: [
                'https://i.gkd.li/i/35165101',
                'https://i.gkd.li/i/35173220',
              ],
              exampleUrls: [
                'https://e.gkd.li/e0c12712-4b1e-4b75-a9ec-d1a8042156f6',
                'https://e.gkd.li/0d2d257a-abda-4255-b971-faf06b565cb7',
                'https://e.gkd.li/4fc71629-5b01-4c60-a356-0b89c3b7e162',
              ],
            },
          ],
        },
      ],
    },
  ],
  disable: [],
  // 不改点击选择器。合并时追加到这些全局组的每一条规则上：画面上有指纹/面容验证时整条不点。
  // 铁路12306（com.MobileTicket）没有「通知提示」「更新提示」应用组，关不掉下面三条默认开启的全局组。
  // 它们在同一窗口里只要还能看到「广告 / 立即 / 开启 / 定位 / 体验 / 更新」或 id 以 image 结尾，就会去点「取消」。
  // 指纹框（系统文案「请验证已有手机指纹」，或标题「指纹登录」）因此会被关掉。开屏与 12306 自己的横幅规则不点「取消」，这里不动。
  globalExclude: [
    {
      groupNames: [
        '通知提示-全局关闭应用的通知提示',
        '更新提示-全局',
        '更新提示-全局关闭应用的更新弹窗',
        '通知提示',
        '更新提示',
        '评价提示',
        '权限提示',
        '定位提示',
        '局部广告',
        '青少年模式',
      ],
      excludeMatches:
        '[text*="指纹" || desc*="指纹" || text*="面容" || desc*="面容" || text*="生物识别" || desc*="生物识别"][visibleToUser=true]',
    },
  ],
  globalGroups: [
    {
      key: 0,
      name: '弹窗广告-广告关闭按钮',
      desc: '自有补充：只点击可见且可点的 vid=ad_close，每个应用最多 1 次。奥怪保留的「开屏广告」全局组不含该选择器（梦念逍遥同名组被覆盖）。已加 visibleToUser 与 actionMaximum，避免无界连点。',
      order: -7,
      fastQuery: true,
      matchTime: 10000,
      actionMaximum: 1,
      resetMatch: 'app',
      rules: [
        {
          key: 0,
          matches: '[vid="ad_close"][clickable=true][visibleToUser=true]',
        },
      ],
    },
  ],
}
